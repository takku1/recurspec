{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:recurspec:schema:contract-node:1.0",
  "title": "Recurspec Contract Node 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "title", "level", "atomic_leaf", "inputs", "outputs", "children", "sections", "invariants"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "title": {"type": "string", "minLength": 1},
    "level": {"type": "integer", "minimum": 0},
    "atomic_leaf": {"type": "boolean"},
    "inputs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "outputs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "children": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "sections": {
      "type": "object",
      "required": ["1", "2", "3", "4", "5"],
      "properties": {
        "1": {"type": "string", "minLength": 1},
        "2": {"type": "string", "minLength": 1},
        "3": {"type": "string", "minLength": 1},
        "4": {"type": "string", "minLength": 1},
        "5": {"type": "string", "minLength": 1},
        "6": {"type": "string", "minLength": 1},
        "7": {"type": "string", "minLength": 1},
        "8": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ears_pattern", "statement", "evidence_stage"],
        "properties": {
          "ears_pattern": {
            "enum": ["Ubiquitous", "Event-driven", "State-driven", "Conditional", "Optional", "Complex"]
          },
          "statement": {"type": "string", "minLength": 1},
          "evidence_stage": {
            "enum": ["Unknown", "Observed", "Sampled", "Inferred", "Measured", "Proved", "Refuted"]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"atomic_leaf": {"const": true}}, "required": ["atomic_leaf"]},
      "then": {"properties": {"sections": {"required": ["6", "7", "8"]}}}
    }
  ]
}
